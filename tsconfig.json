{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "mocha"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "ts-node": {
    "moduleTypes": {
      "app/server/week.ts": "cjs",
      "app/src/chain.ts": "cjs",
      "app/src/trade-feedback.ts": "cjs",
      "app/server/week-api.ts": "cjs"
    }
  }
}
